\begin{tikzpicture}[x=.8cm,y=.8cm,thick,font=\large]
\draw (-4,0)--(-2.5,0) --(-2.5,2)--(2.5,2)--(2.5,0)--(4,0);
\draw (-2.5,0)--(-2.5,-2)--(2.5,-2)--(2.5,0);
\draw (-4,0)--(-1.2,0) (1.2,0)--(4,0);
\draw (-1.2,0)--(-1.2,.8)--(1.2,.8)--(1.2,0);
\draw (-1.2,0)--(-1.2,-.8)--(1.2,-.8)--(1.2,0);
\foreach \x/\y/\name in {-1.25/2/A,1.25/2/B,0/.8/C,0/-.8/D,-1.25/-2/E,1.25/-2/F}{
  \draw[fill=white] (\x-.35,\y-.13) rectangle (\x+.35,\y+.13);
  \node[below=2pt] at (\x,\y){$\name$};
}
\end{tikzpicture}
