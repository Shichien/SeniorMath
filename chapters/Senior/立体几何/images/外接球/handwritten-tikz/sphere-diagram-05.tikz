\begin{tikzpicture}[x=9mm,y=9mm,line width=.55pt,every node/.style={font=\small,inner sep=1.5pt}]
% Orthographic projection: (x,y,z) -> (x, sin(18)y+cos(18)z).
% R=2.5, r=2, half-height=1.5, so every prism vertex is on the sphere.
\foreach \shift/\aa/\bb/\cc in {0/190/290/55,6/180/0/60}{
\begin{scope}[xshift=\shift cm]
\coordinate (O) at (0,0);
\coordinate (O1) at (0,{-1.5*cos(18)});
\coordinate (O2) at (0,{1.5*cos(18)});
\foreach \name/\ang in {A/\aa,B/\bb,C/\cc}{
 \coordinate (\name) at ({2*cos(\ang)},{2*sin(18)*sin(\ang)-1.5*cos(18)});
 \coordinate (\name1) at ({2*cos(\ang)},{2*sin(18)*sin(\ang)+1.5*cos(18)});
}
\draw (O) circle (2.5);
\foreach \z in {-1.5,1.5}{
 \draw[dashed,domain=0:180,samples=60,variable=\t]
 plot ({2*cos(\t)},{2*sin(18)*sin(\t)+\z*cos(18)});
 \draw[domain=180:360,samples=60,variable=\t]
 plot ({2*cos(\t)},{2*sin(18)*sin(\t)+\z*cos(18)});
}
\draw[dashed] (A)--(C)--(B) (A1)--(C1)--(B1) (C)--(C1) (O1)--(O2);
\draw (A)--(B)--(B1)--(A1)--cycle;
\draw (A)--(O);
\draw[dashed] (A)--(O1) (O1)--(C) (O2)--(C1);
\fill (O) circle (1pt) (O1) circle (1pt) (O2) circle (1pt);
\node[right] at (O) {$O$};
\node[below left] at (O1) {$O_1$};
\node[above left] at (O2) {$O_2$};
\node[left] at (A) {$A$};
\node[left] at (A1) {$A_1$};
\node[below right] at (B) {$B$};
\node[right] at (B1) {$B_1$};
\node[above right] at (C) {$C$};
\node[above right] at (C1) {$C_1$};
\end{scope}
}
\end{tikzpicture}
