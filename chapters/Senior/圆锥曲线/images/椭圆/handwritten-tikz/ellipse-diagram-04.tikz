% x^2/9+y^2/5=1; F=(2,0); FA+FB=4 since x_A+x_B=3.
\begin{tikzpicture}[>=Stealth,thick,font=\small]
\coordinate(A)at(.3,{sqrt(5*(1-.3*.3/9))});\coordinate(B)at(2.7,{sqrt(5*(1-2.7*2.7/9))});
\coordinate(F)at(2,0);\coordinate(M)at($(A)!.5!(B)$);
\coordinate(U)at($(M)!1!90:(B)$);\coordinate(O)at(0,0);\coordinate(X)at(1,0);
\coordinate(T)at(intersection of M--U and O--X);
\draw(0,0)ellipse(3 and {sqrt(5)});
\draw[->](-3.6,0)--(3.7,0)node[right]{$x$};\draw[->](0,-2.8)--(0,3)node[above]{$y$};
\draw(A)--(F)--(B)--cycle;
\coordinate(L1)at(-4,-2.8);\coordinate(L2)at(4,-2.8);
\coordinate(H1)at(-4,3);\coordinate(H2)at(4,3);
\draw(intersection of M--U and L1--L2)--(intersection of M--U and H1--H2);
\foreach\p/\pos in {A/above,B/above right,F/below right,T/below right,O/below left}\node[\pos]at(\p){$\p$};
\end{tikzpicture}
