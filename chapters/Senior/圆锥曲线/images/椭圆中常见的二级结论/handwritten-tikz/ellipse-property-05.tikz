\begin{tikzpicture}[x=.7cm,y=.7cm,>=Stealth,font=\small]
\foreach \s in {0,7,14}{\begin{scope}[shift={(\s,0)}]\draw[->] (-3,0)--(3.3,0) node[right]{$x$};\draw[->] (0,-2.4)--(0,2.6) node[above]{$y$};\draw[red!35] (0,0) ellipse (2.6 and 1.6);\node[below left] at (0,0){$O$};\end{scope}}
\begin{scope}\coordinate (P) at (1.35,1.35);\draw[red,thick] (-2.6,0)--(P)--(2.6,0);\node[above] at (P){$P$};\node[left] at (-2.6,0){$A_1$};\node[right] at (2.6,0){$A_2$};\node[above]at(0,1.6){$B_1$};\node[below]at(0,-1.6){$B_2$};\node[below] at (-1.3,0){$F_1$};\node[below] at (1.3,0){$F_2$};\end{scope}
\begin{scope}[shift={(7,0)}]\coordinate (A) at (-2.2,.7);\coordinate (P) at (1.3,1.35);\coordinate (B) at (2.3,-.7);\draw[red,thick] (A)--(P)--(B)--cycle;\foreach \p/\pos in {A/above left,P/above,B/below right}{\node[\pos] at (\p){$\p$};}\end{scope}
\begin{scope}[shift={(14,0)}]\coordinate (A) at (-.5,1.45);\coordinate (M) at (-1.05,.30);\coordinate (B) at (-1.65,-.95);\draw[red,thick] (B)--(A) (M)--(0,0);\foreach \p/\pos in {A/above,M/left,B/below left}{\fill[red](\p)circle(1.5pt);\node[\pos] at (\p){$\p$};}\node[below]at(0,-1.6){$B$};\end{scope}
\end{tikzpicture}
