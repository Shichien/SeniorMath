\begin{tikzpicture}[x=8mm,y=8mm,line width=.5pt,
 every node/.style={font=\small,inner sep=1pt}]
% Cone x^2+y^2=.36z^2, projection (x,y,z) -> (x,z+.24y).
% Conics are parametrised in their actual cutting planes.
\foreach \shift in {0,5,10}{
\begin{scope}[xshift=\shift cm]
\draw[gray,densely dashed] (0,-3.6)--(0,3.6);
\pgfmathsetmacro{\rimx}{1.8*sqrt(1-(.6*.24)^2)}
\pgfmathsetmacro{\rimy}{3*(1-(.6*.24)^2)}
\draw (-\rimx,-\rimy)--(\rimx,\rimy) (-\rimx,\rimy)--(\rimx,-\rimy);
\draw (0,3) ellipse (1.8 and .432);
\draw (0,-3) ellipse (1.8 and .432);
\end{scope}}
% Horizontal circle z=1.65.
\draw[gray] (-2,1.65)--(2,1.65);
\path[draw=red!75!black,fill=red!25,fill opacity=.65,domain=0:360,samples=100,variable=\t]
 plot ({.99*cos(\t)},{1.65+.24*.99*sin(\t)})--cycle;
\node[right] at (1.2,1.5) {圆};
% Ellipse: z=-1.8-.55x; radius in each azimuth is -0.6z.
\draw[gray] (-2,-.7)--(2,-2.9);
\path[draw=red!75!black,fill=red!25,fill opacity=.65,domain=0:360,samples=100,variable=\t]
 plot ({1.08*cos(\t)/(1-.33*cos(\t))},
 {-1.8-.55*1.08*cos(\t)/(1-.33*cos(\t))+.24*1.08*sin(\t)/(1-.33*cos(\t))})--cycle;
\node[right] at (1.5,-2.2) {椭圆};
\begin{scope}[xshift=5cm]
% Rotate the parabolic plane 45 degrees around the cone axis for visibility.
% u=.6z-.72, transverse coordinate t, t^2=.864z-.5184.
\draw[gray] (-1.45,-2.57)--(.99,3.77);
\pgfmathsetmacro{\endp}{sqrt(.864*3-.5184)}
\path[draw=red!75!black,fill=red!25,fill opacity=.65,domain=-\endp:\endp,samples=100,variable=\t]
 plot ({cos(45)*(.6*(\t*\t+.5184)/.864-.72)-sin(45)*\t},
 {(\t*\t+.5184)/.864+.24*(sin(45)*(.6*(\t*\t+.5184)/.864-.72)+cos(45)*\t)})--cycle;
\node[right] at (1.45,1.8) {抛物线};
\end{scope}
\begin{scope}[xshift=10cm]
% Vertical plane y=.72: z=+/-sqrt(x^2+.72^2)/.6.
\pgfmathsetmacro{\endh}{sqrt(1.8*1.8-.72*.72)}
\foreach \sign in {-1,1}{
\path[draw=red!75!black,fill=red!25,fill opacity=.65,domain=-\endh:\endh,samples=100,variable=\t]
 plot ({\t},{\sign*sqrt(\t*\t+.72*.72)/.6+.24*.72})--cycle;
}
\node[right] at (1.4,-1.4) {双曲线};
\end{scope}
\end{tikzpicture}
