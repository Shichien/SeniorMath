\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,3);\coordinate(E)at(-1.1,0);\coordinate(F)at(intersection of E--D and A--B);\coordinate(U)at($(F)+(1,0)$);\coordinate(G)at(intersection of F--U and E--A);\draw(A)--(B)--(C)--(D)--cycle;\draw(E)--(A);\draw(E)--(C);\draw(E)--(D);\draw(G)--(F);\foreach\p/\a in {A/above,B/below,C/below right,D/above right,E/below left,G/left,F/below right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
