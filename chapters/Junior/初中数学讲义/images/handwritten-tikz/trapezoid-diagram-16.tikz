\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3.5);\coordinate(B)at(0,0);\coordinate(C)at(3.5,0);
\coordinate(E)at($(B)!{4/7}!(A)$);
% ED is perpendicular to EC; intersect it with the two parallel bases.
\coordinate(H)at($(E)!1!90:(C)$);
\coordinate(T)at(A -| C);
\coordinate(D)at(intersection of E--H and A--T);
\coordinate(F)at(intersection of E--H and B--C);
\draw(A)--(B)--(C)--(D)--cycle;\draw(F)--(D);\draw(E)--(C);\draw(F)--(B);
\pic[draw,angle radius=2mm]{right angle=C--B--A};
\pic[draw,angle radius=2mm]{right angle=C--E--D};
\foreach\p/\a in {A/above,B/below,D/above,C/below right,F/below left}\node[\a]at(\p){$\p$};\node[left,xshift=-2pt]at(E){$E$};
\end{tikzpicture}
