\begin{tikzpicture}[thick]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(6,0);\coordinate(Bp)at(6,3);\coordinate(E)at(2.3,3);\coordinate(F)at(4.1,0);\coordinate(Ap)at(3.4,5);\draw(A)--(B) (C)--(Bp) (Ap)--(Bp);\draw[blue!70!black](A)--(E)--(Ap) (Bp)--(F)--(B);\draw[red](E)--(F);\draw[dashed](E)--(Bp) (F)--(C);\foreach\p in {A,B,Bp,E,F,Ap}\fill[red](\p)circle(2pt);\foreach\p/\pos in {A/left,B/left,C/right,E/above,F/below}\node[\pos]at(\p){$\p$};\node[right]at(Bp){$B'$};\node[above]at(Ap){$A'$};
\end{tikzpicture}
