\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,3);\coordinate(E)at(1.25,3);\coordinate(M)at(2,3);\coordinate(F)at(3,1.55);
\draw(A)--(B)--(C)--(D)--cycle;\draw(B)--(E);\draw(B)--(M);\draw(A)--(F);
\foreach\p/\a in {A/above left,B/below left,C/below right,D/above right,E/above,M/above,F/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
