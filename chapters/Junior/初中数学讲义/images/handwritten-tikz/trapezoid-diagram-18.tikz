\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(1,2.5);\coordinate(B)at(0,0);\coordinate(C)at(4,0);\coordinate(D)at(3,2.5);\coordinate(O)at(2,1.25);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(C);\draw(B)--(D);\node at(2,2){S1};\node[gray] at(2,.5){S2};\node at(.9,1.25){S3};\node at(3.1,1.25){S4};\foreach\p/\a in {A/above,B/left,C/right,D/above,O/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
