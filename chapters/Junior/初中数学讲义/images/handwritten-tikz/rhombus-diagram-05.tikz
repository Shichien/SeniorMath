\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small,line join=round]
  \coordinate (A) at (1.25,3); \coordinate (B) at (0,0); \coordinate (C) at (4.4,0); \coordinate (D) at (5.65,3); \coordinate (M) at (2,1.1);
  \draw (A)--(B)--(C)--(D)--cycle (B)--(D) (A)--(M);
  \foreach \p/\pos in {A/above,B/below left,C/below,D/above right,M/below right} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
