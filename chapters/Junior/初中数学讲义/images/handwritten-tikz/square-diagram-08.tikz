\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,2.4);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,2.4);\coordinate(E)at(.75,1.8);\coordinate(F)at(3,1.05);
\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(C);\draw(B)--(F);\draw(E)--(D);\draw(E)--(F);
\foreach\p/\a in {A/above left,B/below left,C/below right,D/above right,E/above,F/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
