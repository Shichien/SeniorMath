\begin{tikzpicture}[thick]
\coordinate (A) at (1.2,3.7); \coordinate (B) at (0,0); \coordinate (C) at (5.2,0);
\coordinate (D) at ($(A)+(C)-(B)$);
% The original diagram places E at the midpoint of BC.
\coordinate (E) at ($(B)!0.5!(C)$);
% Reflect B across the crease AE, then intersect the reflected ray with CD.
\coordinate (H) at ($(A)!(B)!(E)$);
\coordinate (F) at ($(B)!2!(H)$);
\coordinate (G) at (intersection of A--F and C--D);
\draw(A)--(B)--(C)--(D)--cycle(A)--(G) (A)--(E)--(F);\foreach\p/\pos in {A/above,B/left,C/below,D/above,E/below,F/above,G/right}\node[\pos]at(\p){$\p$};
\end{tikzpicture}
