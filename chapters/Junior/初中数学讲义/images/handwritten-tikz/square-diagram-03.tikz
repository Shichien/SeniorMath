\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,0);\coordinate(B)at(3,0);\coordinate(C)at(3,3);\coordinate(D)at(0,3);
\coordinate(E)at($(C)!.5!(D)$);\coordinate(F)at($(A)!.5!(D)$);
\coordinate(P)at(intersection of B--E and C--F);
\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(P) (E)--(B) (F)--(C);
\foreach\p/\a in {A/below left,B/below right,C/above right,D/above left,E/above,F/left}\node[\a]at(\p){$\p$};
\node[right,xshift=2pt,yshift=-2pt]at(P){$P$};
\end{tikzpicture}
