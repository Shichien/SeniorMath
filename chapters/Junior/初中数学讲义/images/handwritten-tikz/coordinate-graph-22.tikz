\begin{tikzpicture}[thick]
\coordinate(A)at(.7,4);\coordinate(B)at(0,0);\coordinate(C)at(6.5,0);\coordinate(D)at(5,4);\coordinate(E)at($(B)!.425!(A)$);\coordinate(G)at($(C)!.425!(D)$);\coordinate(F)at(intersection of E--G and A--C);\draw(A)--(B)--(C)--(D)--cycle(E)--(G) (A)--(C);\foreach\p/\pos in {A/above,B/below left,C/below right,D/above,E/left,G/right,F/below left}\node[\pos]at(\p){$\p$};
