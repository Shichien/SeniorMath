\begin{tikzpicture}[thick,font=\small]
\draw(0,0)rectangle(1.2,1.2);\draw(1.2,0)rectangle(3,1.8);\draw(3,0)rectangle(6,3);\draw(0,0)--(6,3);\fill[gray!20](1.2,.6)--(1.2,1.8)--(3,1.8)--(3,1.5)--cycle;\begin{scope}\clip(1.2,.6)--(1.2,1.8)--(3,1.8)--(3,1.5)--cycle;\foreach\x in {.2,.5,...,3.5}\draw[gray](\x,.25)--++(60:2.4);\end{scope}\node[above]at(.6,1.2){$2$};\node[above]at(2.1,1.8){$3$};\node[above]at(4.5,3){$5$};
\end{tikzpicture}
