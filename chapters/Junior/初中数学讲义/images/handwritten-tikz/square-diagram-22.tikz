\begin{tikzpicture}[thick,font=\small,line join=round]
\coordinate(A)at(.9,3.3);\coordinate(B)at(0,2);\coordinate(C)at(.9,0);\coordinate(D)at(3,0);\coordinate(E)at(3.7,.8);\coordinate(F)at(2.15,3.3);\draw(A)--(B)--(C)--(D)--(E)--(F)--cycle;\fill(A)circle(2pt);\fill(B)circle(2pt);\fill(C)circle(2pt);\fill(D)circle(2pt);\node[left]at(.45,2.8){$5$};\node[left]at(.35,1){$9$};\node[below]at(2,0){$9$};\node[right]at(3.35,.35){$1$};\foreach\p/\a in {A/above,B/left,C/below,D/below,E/right,F/above}\node[\a]at(\p){$\p$};
\end{tikzpicture}
