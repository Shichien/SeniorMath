\begin{tikzpicture}[line width=1pt,font=\small]
\def\side{3}
\pgfmathsetmacro{\radius}{\side*sqrt(5)/2}
\pgfmathsetmacro{\arcstart}{atan(2)}
\coordinate(A)at(0,0);\coordinate(D)at(0,\side);
\coordinate(C)at(\side,\side);\coordinate(B)at(\side,0);
\coordinate(M)at($(D)!.5!(C)$);\coordinate(N)at($(A)!.5!(B)$);
\coordinate(E)at($(N)+(\radius,0)$);\coordinate(F)at(E|-D);
\draw(A)--(D)--(F)--(E)--cycle;\draw(B)--(C);
\draw[dash pattern=on 5pt off 4pt](M)--(N)--(C);
% Circle centered at N with radius NC, meeting AB extended at E.
\draw(C)arc[start angle=\arcstart,end angle=0,radius=\radius];
\foreach\p/\a in {A/below left,D/above left,M/above,N/below,B/below,C/above,E/below right,F/above right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
