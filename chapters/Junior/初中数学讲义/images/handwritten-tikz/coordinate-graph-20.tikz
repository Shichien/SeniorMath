\begin{tikzpicture}[thick]
\coordinate(A)at(5,5);\coordinate(B)at(0,0);\coordinate(C)at(7,0);\coordinate(D)at(2.5,2.5);\coordinate(E)at(1.8,0);\coordinate(G)at($(A)!.5!(C)$);\coordinate(N)at(5,0);\coordinate(F)at($(B)!(G)!(C)$);\draw(A)--(B)--(C)--cycle(D)--(E) (D)--(G) (A)--(N) (G)--(F);\draw(N)rectangle+(.3,.3);\draw(F)rectangle+(.3,.3);\foreach\p/\pos in {A/above,B/left,C/right,D/left,E/below,G/right,N/below,F/below}\node[\pos]at(\p){$\p$};
\end{tikzpicture}
