\begin{tikzpicture}[line width=.65pt,font=\small]
\begin{scope}
  \coordinate (A) at (0,2.45);
  \coordinate (B) at (0,0);
  \coordinate (C) at (2.45,0);
  \coordinate (D) at (2.45,2.45);
  \coordinate (E) at (3.7,0);
  \coordinate (P) at ($(A)!.79!(C)$);
  \draw (A)--(B)--(C)--(D)--cycle;
  \draw (A)--(C);
  \draw (B)--(P);
  \draw (D)--(P);
  \draw (P)--(E);
  \draw (C)--(E);
  \foreach \p/\a in {A/above left,B/below left,C/below,D/above right,E/below right,P/above left}
    \node[\a,inner sep=1pt] at (\p) {$\p$};
  \node at (1.85,-.62) {(1)};
\end{scope}
\begin{scope}[xshift=5.05cm]
  \coordinate (B) at (0,0);
  \coordinate (C) at (2.15,0);
  \coordinate (A) at (66.7:2.15);
  \coordinate (D) at ($(A)+(2.15,0)$);
  \coordinate (E) at (3.35,0);
  \coordinate (P) at ($(A)!.59!(C)$);
  \draw (A)--(B)--(C)--(D)--cycle;
  \draw (A)--(C);
  \draw (B)--(P);
  \draw (D)--(P);
  \draw (P)--(E);
  \draw (C)--(E);
  \foreach \p/\a in {A/above left,B/below left,C/below,D/above right,E/below right,P/above left}
    \node[\a,inner sep=1pt] at (\p) {$\p$};
  \node at (1.68,-.62) {(2)};
\end{scope}
\end{tikzpicture}
