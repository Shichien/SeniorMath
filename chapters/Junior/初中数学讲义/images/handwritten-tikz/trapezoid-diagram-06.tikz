\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.55,1.5);\coordinate(B)at(0,0);\coordinate(C)at(4,0);\coordinate(D)at(2.7,1.5);\coordinate(E)at(1.65,1.5);\coordinate(F)at(1.95,0);\draw(A)--(B)--(C)--(D)--cycle;\draw(E)--(F);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/above,F/below}\node[\a]at(\p){$\p$};
