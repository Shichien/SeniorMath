\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.75,2.7);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(2.2,2.7);\coordinate(E)at(.38,1.35);\coordinate(F)at(2.6,1.35);\draw(A)--(B)--(C)--(D)--cycle;\draw(E)--(F);\draw(B)--(D);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/left,F/right}\node[\a]at(\p){$\p$};
