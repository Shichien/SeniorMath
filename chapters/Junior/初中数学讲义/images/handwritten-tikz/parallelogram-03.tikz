\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small,line join=round]
  \coordinate (A) at (1.1,2.5); \coordinate (B) at (0,0); \coordinate (C) at (4.6,0); \coordinate (D) at (5.7,2.5);
  \coordinate (F) at (2.6,2.5); \coordinate (E) at (3.05,0); \coordinate (O) at (2.85,1.25);
  \draw (A)--(B)--(C)--(D)--cycle (A)--(C) (B)--(D) (F)--(E);
  \foreach \p/\pos in {A/above left,B/below left,C/below,D/above right,F/above,E/below,O/right} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
