\def\quad#1#2#3#4#5#6#7#8#9{\begin{scope}[shift={(#1,#2)}]\draw (#3)--(#4)--(#5)--(#6)--cycle;\draw (#7)--(#8)--(#9)--(#6);\end{scope}}
\begin{scope}\coordinate(A)at(0,0);\coordinate(B)at(2,0);\coordinate(C)at(2.55,1);\coordinate(D)at(.45,1);\coordinate(M)at(1.5,1);\coordinate(N)at(.2,.5);\coordinate(P)at(1,0);\coordinate(Q)at(2.28,.5);\draw(A)--(B)--(C)--(D)--cycle;\draw(M)--(N)--(P)--(Q)--cycle;\foreach\p/\a in {A/below left,B/below,C/above right,D/above left,M/above,N/left,P/below,Q/right}\node[\a]at(\p){$\p$};\end{scope}
