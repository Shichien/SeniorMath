\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,3);\coordinate(E)at(1.1,3);\coordinate(F)at(1.8,3);
\path[name path=CF](C)--(F);\path[name path=BD](B)--(D);\path[name intersections={of=CF and BD,by=G}];
\path[name path=BE](B)--(E);\path[name path=AG](A)--(G);\path[name intersections={of=BE and AG,by=H}];
\draw(A)--(B)--(C)--(D)--cycle;\draw(B)--(E);\draw(C)--(F);\draw(A)--(G);\draw(B)--(D);\draw(H)--(D);\foreach\p/\a in {A/above left,B/below left,C/below right,D/above right,E/above,F/above,H/left,G/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
