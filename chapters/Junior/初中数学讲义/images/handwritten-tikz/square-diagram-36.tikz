\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(-3,0);\coordinate(C)at(2.2,0);\coordinate(D)at(-1.45,1.55);\coordinate(E)at(-1.45,0);\coordinate(G)at($(A)!{1.45/3}!(C)$);\coordinate(F)at($(B)!(G)!(C)$);\coordinate(M)at(0,0);\coordinate(N)at(0,1.55);\fill[gray!45](D)--(E)--(F)--(G)--cycle;\draw[blue!70!black](A)--(B)--(C)--cycle;\draw[blue!70!black](D)--(E);\draw[blue!70!black](D)--(G)--(F);\draw[blue!70!black,dashed](A)--(M);\foreach\p in {A,B,C,D,E,F,G,M,N}\fill[red](\p)circle(2pt);\foreach\p/\a in {A/above,B/left,C/right,D/above,E/below,F/below,G/right,M/below,N/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
