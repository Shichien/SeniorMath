\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small,line join=round]
  \coordinate (A) at (0,0); \coordinate (B) at (4.8,0); \coordinate (C) at (6.1,2.8); \coordinate (D) at (1.3,2.8);
  \coordinate (F) at (.75,1.45); \coordinate (E) at (2.55,0);
  \draw (A)--(B)--(C)--(D)--cycle (F)--(C) (F)--(E)--(C);
  \foreach \p/\pos in {A/below left,B/below,C/above right,D/above left,E/below,F/left} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
