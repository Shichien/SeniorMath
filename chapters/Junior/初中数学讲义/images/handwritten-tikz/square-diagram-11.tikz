\begin{tikzpicture}[line width=.55pt,font=\small]
\coordinate(A)at(0,0);\coordinate(B)at(3,0);\coordinate(C)at(3,3);\coordinate(D)at(0,3);\coordinate(E)at(1.55,3);\coordinate(F)at(2.02,2.02);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(C);\draw(D)--(F);\draw(E)--(B);\foreach\p/\a in {A/below left,B/below right,C/above right,D/above left,E/above,F/below right}\node[\a]at(\p){$\p$};
