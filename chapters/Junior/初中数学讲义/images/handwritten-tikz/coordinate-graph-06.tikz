\begin{tikzpicture}[>=stealth,thick]
\draw[->](-1.2,0)--(7,0)node[right]{$x$};\draw[->](0,-.8)--(0,7)node[above]{$y$};
\coordinate(A)at(1.2,1);\coordinate(B)at(5.8,2.5);\coordinate(C)at(3.7,6.2);\coordinate(D)at(3.7,1.815);
