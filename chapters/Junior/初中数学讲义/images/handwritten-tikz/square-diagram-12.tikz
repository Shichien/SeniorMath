\begin{tikzpicture}[thick,font=\small,line join=round]
\coordinate(B)at(0,0);\coordinate(C)at(0,2.4);\coordinate(D)at(2.4,2.4);\coordinate(A)at(2.4,0);\coordinate(G)at(.75,0);\coordinate(E)at(4.25,1.1);\coordinate(F)at(3.1,-1.25);\fill[gray!55](C)--(D)--(E)--cycle;\draw(B)--(C)--(D)--(A)--(G)--cycle;\draw(G)--(D)--(E)--(F)--cycle;\draw(C)--(E);\foreach\p/\a in {A/below,B/left,C/above left,D/above,E/right,F/below,G/below}\node[\a]at(\p){$\p$};
