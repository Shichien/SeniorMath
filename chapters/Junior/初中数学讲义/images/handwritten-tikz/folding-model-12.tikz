\begin{tikzpicture}[thick]
\coordinate(A)at(0,0);\coordinate(B)at(0,3);\coordinate(C)at(5,3);\coordinate(D)at(5,0);\coordinate(E)at(1.5,3);
% PQ is the perpendicular bisector of AE.
\coordinate (M) at ($(A)!0.5!(E)$);
\coordinate (N) at ($(M)!1!90:(E)$);
\coordinate (P) at (intersection of M--N and A--B);
\coordinate (Q) at (intersection of M--N and A--D);
\draw(P)--(B)--(C)--(D)--(Q)--(P)--(E)--(Q);\draw[densely dashed](P)--(A)--(Q);\foreach\p/\pos in {A/below left,B/above left,C/above right,D/below right,E/above,P/left,Q/below}\node[\pos]at(\p){$\p$};
\end{tikzpicture}
