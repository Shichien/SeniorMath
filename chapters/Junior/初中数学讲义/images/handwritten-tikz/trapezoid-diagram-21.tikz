\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.55,2.5);\coordinate(B)at(0,0);\coordinate(C)at(3.3,0);\coordinate(D)at(2.35,2.5);\coordinate(E)at(.28,1.25);\coordinate(F)at(2.82,1.25);\coordinate(M)at(1.12,1.25);\coordinate(N)at(1.85,1.25);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(C);\draw(B)--(D);\draw(E)--(F);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/left,F/right,M/above,N/above}\node[\a]at(\p){$\p$};
