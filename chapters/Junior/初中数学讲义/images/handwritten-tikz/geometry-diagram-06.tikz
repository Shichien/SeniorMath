\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small,line join=round]
  \coordinate (A) at (1.1,3.8); \coordinate (B) at (3.0,3.8); \coordinate (C) at (4.1,0); \coordinate (D) at (0,0);
  \coordinate (E) at (.55,1.9); \coordinate (F) at (3.55,1.9);
  \draw (A)--(B)--(C)--(D)--cycle (E)--(B) (E)--(C);
  \draw[densely dashed] (E)--(F);
  \foreach \p/\pos in {A/above left,B/above right,C/below right,D/below left,E/left,F/right} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
