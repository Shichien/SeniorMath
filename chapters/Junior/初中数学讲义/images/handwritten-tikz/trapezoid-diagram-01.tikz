\begin{tikzpicture}[thick,font=\small,line join=round]
\coordinate(A)at(0,3);\coordinate(B)at(-2.05,0);\coordinate(C)at(3,0);\coordinate(D)at(5.05,3);\coordinate(O)at($(A)!.5!(C)$);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(C);\draw(B)--(D);\foreach\p/\a in {A/above,B/below left,C/below,D/above right,O/below}\node[\a]at(\p){$\p$};
