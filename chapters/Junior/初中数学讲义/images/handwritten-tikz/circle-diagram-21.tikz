\begin{tikzpicture}[thick]
\begin{scope}
\coordinate (A) at (3,3); \coordinate (B) at (0,0); \coordinate (C) at (4.5,0);
% CD / CB = CA^2 / CB^2.
\coordinate (D) at ($(C)!{(1.5*1.5+3*3)/(4.5*4.5)}!(B)$);
\draw (A)--(B)--(C)--cycle (A)--(D);
\foreach \p/\pos in {A/above,B/left,C/right,D/below}\node[\pos] at (\p){$\p$};
\node at (2.2,-.8){图(1)};
\end{scope}
\begin{scope}[xshift=7cm]
\coordinate (A) at (3,3.6); \coordinate (B) at (0,1.3); \coordinate (C) at (3.9,1.3);
\coordinate (D) at ($(C)!{(0.9*0.9+2.3*2.3)/(3.9*3.9)}!(B)$);
% Extend AC by the factor AB / AC, so AE = AB.
\coordinate (E) at ($(A)!{sqrt((3*3+2.3*2.3)/(0.9*0.9+2.3*2.3))}!(C)$);
\coordinate (F) at (intersection of A--D and B--E);
\draw (A)--(B)--(E)--cycle (B)--(C) (A)--(F);
\foreach \p/\pos in {A/above,B/left,C/right,D/above left,F/below,E/right}\node[\pos] at (\p){$\p$};
\node at (2.2,-.8){图(2)};
\end{scope}
\end{tikzpicture}
