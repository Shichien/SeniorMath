\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,3);\coordinate(E)at(3,1.65);\coordinate(M)at(1.45,2.35);
\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(E);\fill (M) circle (1.7pt);\foreach\p/\a in {A/above left,B/below left,C/below right,D/above right,E/right,M/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
