\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,0);\coordinate(B)at(0,3);\coordinate(C)at(3,3);\coordinate(D)at(3,0);\coordinate(M)at(1.55,0);\coordinate(G)at(1.05,1.05);\fill[gray!55](A)--(B)--(G)--cycle;\fill[gray!55](G)--(M)--(C)--cycle;\draw(A)--(B)--(C)--(D)--cycle;\draw(B)--(M)--(C)--(A);\foreach\p/\a in {A/below left,B/above left,C/above right,D/below right,M/below,G/above}\node[\a]at(\p){$\p$};
\end{tikzpicture}
