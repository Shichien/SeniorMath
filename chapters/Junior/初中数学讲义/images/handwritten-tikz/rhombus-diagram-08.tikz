\begin{tikzpicture}[scale=.9,line width=.65pt,font=\small,line join=round]
  \coordinate (A) at (1.4,0); \coordinate (B) at (5.6,0); \coordinate (C) at (0,4.5);
  \draw (A)--(B)--(C)--cycle;
% No equal-side condition is given in the construction problem.
  \foreach \p/\pos in {A/below,B/right,C/above left} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
