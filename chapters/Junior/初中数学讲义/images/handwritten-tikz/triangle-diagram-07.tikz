\begin{tikzpicture}[thick]\coordinate(A)at(3,4);\coordinate(B)at(0,0);\coordinate(C)at(6,0);\coordinate(D)at(1.55,2);\coordinate(F)at(4.45,2);\coordinate(E)at(3,0);\draw(A)--(B)--(C)--cycle(D)--(F)--(E)--cycle;\foreach\p in {A,B,C,D,E,F}\fill(\p)circle(1.7pt);\foreach\p/\pos in {A/above,B/below left,C/below right,D/left,E/below,F/right}\node[\pos]at(\p){$\p$};\end{tikzpicture}
