\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small,line join=round]
  \coordinate (A) at (0,2.8); \coordinate (B) at (0,0); \coordinate (C) at (4.8,0); \coordinate (D) at (4.8,2.8); \coordinate (P) at (2.35,3.45);
  \draw (A)--(B)--(C)--(D)--cycle (A)--(C) (B)--(D) (A)--(P)--(C) (B)--(P)--(D);
  \foreach \p/\pos in {A/left,B/left,C/right,D/right,P/above} \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
