\begin{tikzpicture}[scale=.82,line width=.6pt,font=\small,line join=round]
  \coordinate (A) at (4.4,6); \coordinate (B) at (0,0); \coordinate (C) at (4.4,0); \coordinate (D) at (1.8,2.455); \coordinate (E) at (2.5,0); \coordinate (F) at (2.94,1.38); \coordinate (G) at (1.01,1.38);
  \draw (A)--(B)--(C)--cycle (A)--(E) (D)--(C) (G)--(E) (G)--(F);
  \draw (4.05,0)--(4.05,.35)--(4.4,.35);
  \foreach \p/\pos in {A/above,B/below left,C/below right,D/left,E/below,F/right,G/left} \node[\pos] at (\p) {$\p$};
