\begin{tikzpicture}[thick]
\coordinate(A)at(0,4.5);\coordinate(B)at(0,0);\coordinate(D)at(5,4.5);\coordinate(E)at(4.3,0);\coordinate(C)at(8.4,0);\coordinate(Cp)at(0,1.1);\draw(A)--(B)--(C)--(D)--cycle;\draw[dashed](Cp)--(D)--(E)--(Cp);\foreach\p/\pos in {A/above left,B/below left,C/below right,D/above,E/below}\node[\pos]at(\p){$\p$};\node[left]at(Cp){$C'$};
