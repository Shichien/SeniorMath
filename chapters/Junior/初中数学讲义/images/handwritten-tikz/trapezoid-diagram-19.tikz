\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.8,2.4);\coordinate(B)at(0,0);\coordinate(C)at(3.4,0);\coordinate(D)at(2.5,2.4);\coordinate(E)at(.4,1.2);\coordinate(F)at(2.95,1.2);\coordinate(G)at(5,0);\draw(A)--(B)--(C)--(D)--cycle;\draw(E)--(F);\draw[dashed](A)--(F)--(G);\draw[dashed](C)--(G);\foreach\p in {A,B,C,D,E,F,G}\fill(\p)circle(1.5pt);\foreach\p/\a in {A/above,B/below left,C/below,D/above,E/left,F/right,G/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
