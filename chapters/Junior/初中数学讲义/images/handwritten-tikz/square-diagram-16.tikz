\begin{tikzpicture}[line width=.65pt,font=\small,>=stealth]
\coordinate (O) at (0,0);
\coordinate (E) at (-1,0);
\coordinate (A) at (0,2);
\coordinate (B) at (2,1);
\coordinate (C) at (3,3);
\coordinate (D) at (1,4);
\draw[->] (-1.55,0)--(3.7,0) node[right] {$x$};
\draw[->] (0,-.45)--(0,4.65) node[above] {$y$};
\draw (A)--(B)--(C)--(D)--cycle;
\draw (E)--(A);
\draw (E)--(C);
\foreach \p/\a in {O/below right,E/below left,A/left,B/below right,C/right,D/above}
  \node[\a,inner sep=1pt] at (\p) {$\p$};
\end{tikzpicture}
