\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,1.5);\coordinate(B)at(-3.2,0);\coordinate(C)at(0,-1.5);\coordinate(D)at(3.2,0);\coordinate(E)at(-1.5,0);\coordinate(F)at(1.5,0);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(E)--(C)--(F)--cycle;\foreach\p/\a in {A/above,B/left,C/below,D/right,E/left,F/right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
