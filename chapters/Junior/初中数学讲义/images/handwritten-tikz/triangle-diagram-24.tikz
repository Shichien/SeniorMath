\begin{tikzpicture}[thick,blue!70!black]\coordinate(A)at(0,0);\coordinate(D)at(4.3,0);\coordinate(C)at(8,0);\coordinate(B)at(8,3);\draw(A)--(B)--(C)--(A);\draw[dashed](D)--(B);\draw(C)rectangle+(-.35,.35);\draw(.7,0)arc[start angle=0,end angle=20.5,radius=.7];\foreach\p in {A,B,C,D}\fill[red](\p)circle(3pt);\foreach\p/\pos in {A/left,B/above,C/below,D/below}\node[black,\pos]at(\p){$\p$};\node at(1,-1){$15^\circ$};\draw(.9,-.75)--(1.2,-.05);\end{tikzpicture}
