\begin{tikzpicture}[x=7mm,y=7mm,line cap=round,line join=round,line width=.6pt,every node/.style={font=\small,inner sep=2pt}]
\coordinate (A) at (0,3);
\coordinate (B) at (0,0);
\coordinate (C) at (3,0);
\coordinate (D) at (3,3);
\coordinate (Ap) at ($(A)!1/3!(B)$);
\coordinate (Bp) at ($(B)!1/3!(C)$);
\coordinate (Cp) at ($(C)!1/3!(D)$);
\coordinate (Dp) at ($(D)!1/3!(A)$);
\draw (A)--(B)--(C)--(D)--cycle (Ap)--(Bp)--(Cp)--(Dp)--cycle;
\node[above left] at (A) {$A$};
\node[below left] at (B) {$B$};
\node[below right] at (C) {$C$};
\node[above right] at (D) {$D$};
\node[left] at (Ap) {$A'$};
\node[below] at (Bp) {$B'$};
\node[right] at (Cp) {$C'$};
\node[above] at (Dp) {$D'$};

\end{tikzpicture}
