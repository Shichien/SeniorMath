\begin{tikzpicture}[scale=.9,line width=.55pt,font=\small]
  \coordinate (A) at (0,3); \coordinate (B) at (0,0); \coordinate (C) at (5,0); \coordinate (D) at (5,3); \coordinate (P) at (2.2,3);
  \coordinate (E) at (1.618,2.029); \coordinate (F) at (2.941,1.765); \coordinate (O) at (2.5,1.5);
  \draw (A)--(B)--(C)--(D)--cycle (A)--(C) (B)--(D) (P)--(E) (P)--(F);
