\begin{tikzpicture}[x=.65cm,y=.65cm,line width=.5pt,font=\scriptsize,line join=round]
  \begin{scope}
    \coordinate (A) at (0,0); \coordinate (B) at (4,0); \coordinate (D) at (0,2.2);
    \coordinate (C) at ($(D)!.5!(B)!1!90:(B)$);
    \draw (A)--(B)--(C)--(D)--cycle (A)--(C);
    \draw ($(A)!.20cm!(D)$)--($(A)!.20cm!(D)+(A)!.20cm!(B)-(A)$)--($(A)!.20cm!(B)$);
    \draw ($(C)!.20cm!(D)$)--($(C)!.20cm!(D)+(C)!.20cm!(B)-(C)$)--($(C)!.20cm!(B)$);
    \foreach \p/\pos in {A/below left,B/below right,D/left} \node[\pos] at (\p) {$\p$};
    \node[above] at (C) {$C$};
  \end{scope}
  \begin{scope}[shift={(6.2,0)}]
    \coordinate (A) at (0,2); \coordinate (B) at (4,-.4); \coordinate (D) at (-1.2,0);
    \coordinate (C) at ($(D)!.5!(B)!1!90:(B)$);
    \draw (A)--(B)--(C)--(D)--cycle (A)--(C);
    \draw ($(A)!.20cm!(D)$)--($(A)!.20cm!(D)+(A)!.20cm!(B)-(A)$)--($(A)!.20cm!(B)$);
    \draw ($(C)!.20cm!(D)$)--($(C)!.20cm!(D)+(C)!.20cm!(B)-(C)$)--($(C)!.20cm!(B)$);
    \foreach \p/\pos in {A/above left,B/below right,C/above,D/left} \node[\pos] at (\p) {$\p$};
  \end{scope}
  \begin{scope}[shift={(12.4,0)}]
    \coordinate (A) at (0,0); \coordinate (B) at (4,0); \coordinate (D) at (60:3);
    \coordinate (C) at ($(D)!.5!(B)!{1/sqrt(3)}!90:(B)$);
    \draw (A)--(B)--(C)--(D)--cycle (A)--(C);
    \foreach \p/\pos in {A/below left,B/below right,C/above,D/above left} \node[\pos] at (\p) {$\p$};
  \end{scope}
  \begin{scope}[shift={(18.8,1.5)},rotate=-17]
    % The crossed configuration has angle DAB=120 degrees, not 60.
    \coordinate (A) at (0,0); \coordinate (B) at (4.8,0); \coordinate (D) at (-120:2);
    \coordinate (C) at ($(D)!.5!(B)!{1/sqrt(3)}!90:(B)$);
    \draw (A)--(B)--(C)--(D)--cycle (A)--(C);
    \foreach \p/\pos in {A/above left,B/right,C/above,D/left} \node[\pos] at (\p) {$\p$};
  \end{scope}
\end{tikzpicture}
