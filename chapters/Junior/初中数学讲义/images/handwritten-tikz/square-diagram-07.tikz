\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,3);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(3,3);\coordinate(O)at(1.5,1.5);\coordinate(E)at(3,1);\coordinate(F)at(2.7,.9);
