\begin{tikzpicture}[scale=.85,line width=.55pt,font=\normalsize,line join=round]
  \coordinate (A) at (0,4);
  \coordinate (B) at (0,0);
  \coordinate (C) at (4,0);
  \coordinate (D) at (4,4);
  \coordinate (E) at ({-2*sqrt(3)},2);
  \coordinate (M) at ($(B)!.31!(D)$);
  % N is the image of M after a 60-degree counterclockwise rotation about B.
  \coordinate (N) at ({-.31*4*(sqrt(3)-1)/2},{.31*4*(sqrt(3)+1)/2});

  \draw (A)--(B)--(C)--(D)--cycle;
  \draw (E)--(A) (E)--(B) (E)--(N)--(B);
  \draw (B)--(D) (A)--(M)--(C);

  \foreach \p/\pos in {A/above,B/below,C/below right,D/above right,E/left,N/above,M/below right}
    \node[\pos] at (\p) {$\p$};
\end{tikzpicture}
