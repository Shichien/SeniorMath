\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.75,2.7);\coordinate(C)at(0,0);\coordinate(D)at(2.6,2.7);\coordinate(F)at(3.5,0);
\coordinate(B)at($(A)!.6!(C)$);\coordinate(E)at($(D)!.6!(F)$);
\draw(A)--(C)--(F)--(D)--cycle;\draw(B)--(E);\foreach\p/\a in {A/above,B/left,C/below left,D/above,E/right,F/below right}\node[\a]at(\p){$\p$};
\end{tikzpicture}
