\begin{tikzpicture}[thick]
\coordinate (A) at (3,5); \coordinate (B) at (0,0); \coordinate (C) at (4,0); \coordinate (D) at (1.32,2.2); \coordinate (E) at (3.56,2.2); \coordinate (F) at (2.35,0); \coordinate (G) at (2.636,2.2);
