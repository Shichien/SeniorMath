\begin{tikzpicture}[thick,font=\small]
% The length unit is 3: AB=CD=AD=2 and BC=4.
\coordinate(B)at(0,0);\coordinate(C)at(4,0);
\coordinate(A)at(1,{sqrt(3)});\coordinate(D)at(3,{sqrt(3)});
\coordinate(P)at($(B)!.42!(C)$);
\coordinate(E)at($(B)!(P)!(A)$);\coordinate(F)at($(C)!(P)!(D)$);
\draw[brown!70!black](A)--(B)--(C)--(D)--cycle;
\draw[green!60!black](E)--(P)--(F);
\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/left,F/right,P/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
