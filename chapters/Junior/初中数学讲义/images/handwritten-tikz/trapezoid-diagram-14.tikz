\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(1,2.5);\coordinate(B)at(0,0);\coordinate(C)at(4,0);\coordinate(D)at(3.1,2.5);\coordinate(E)at(.55,.95);\coordinate(F)at(3.65,.95);\coordinate(P)at(2,0);\draw[brown!70!black](A)--(B)--(C)--(D)--cycle;\draw[green!60!black](E)--(P)--(F);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/left,F/right,P/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
