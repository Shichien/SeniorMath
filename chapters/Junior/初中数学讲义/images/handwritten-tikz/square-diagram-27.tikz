\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(0,2.6);\coordinate(B)at(0,0);\coordinate(C)at(2.6,0);\coordinate(D)at(2.6,2.6);\coordinate(P)at($(B)!.76!(D)$);\draw(A)--(B)--(C)--(D)--cycle;\draw(A)--(P)--(C);\draw(B)--(D);\foreach\p/\a in {A/above left,B/below left,C/below right,D/above right,P/right}\node[\a]at(\p){$\p$};
