\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.75,2.5);\coordinate(B)at(0,0);\coordinate(C)at(3,0);\coordinate(D)at(2,2.5);\coordinate(E)at(2,1);\coordinate(F)at(2,0);\draw(A)--(B)--(C)--(D)--cycle;\draw(D)--(F);\draw(B)--(E)--(C);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/right,F/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
