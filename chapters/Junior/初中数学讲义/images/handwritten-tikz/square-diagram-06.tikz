\begin{tikzpicture}[x=7mm,y=7mm,line cap=round,line join=round,line width=.6pt,every node/.style={font=\small,inner sep=2pt}]
\coordinate (A) at (0,3);
\coordinate (B) at (0,0);
\coordinate (C) at (3,0);
\coordinate (D) at (3,3);
\coordinate (M) at (-0.75,0);
\coordinate (N) at (3,-2);
\coordinate (H) at ($(M)!(A)!(N)$);
\draw (A)--(B)--(C)--(D)--cycle (C)--(N) (A)--(M) (A)--(N) (H)--(N) (A)--(H) (-1.7,0)--(B);
\draw ($(H)!.18cm!(A)$)--($(H)!.18cm!(A)+($(H)!.18cm!(N)$)-(H)$)--($(H)!.18cm!(N)$);
\node[above] at (A) {$A$};
\node[below right] at (B) {$B$};
\node[right] at (C) {$C$};
\node[above right] at (D) {$D$};
\node[below left] at (M) {$M$};
\node[below] at (N) {$N$};
\node[left] at (H) {$H$};

\end{tikzpicture}
