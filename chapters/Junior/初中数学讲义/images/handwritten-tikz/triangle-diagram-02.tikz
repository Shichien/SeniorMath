\begin{tikzpicture}[thick]\coordinate(A)at(0,0);\coordinate(B)at(5.2,0);\coordinate(C)at(3,4);\coordinate(D)at(0,3);\coordinate(M)at($(B)!.55!(C)$);\coordinate(N)at(2.5,0);\coordinate(E)at($(D)!.5!(M)$);\coordinate(F)at($(M)!.5!(N)$);\draw(A)--(B)--(C)--(D)--cycle(D)--(M)--(N) (E)--(F);\foreach\p/\pos in {A/below left,B/below right,C/above,D/left,M/right,N/below,E/above,F/right}\node[\pos]at(\p){$\p$};\end{tikzpicture}
