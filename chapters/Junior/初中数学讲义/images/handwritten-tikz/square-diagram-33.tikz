\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(1.5,2.5);\coordinate(B)at(1.5,0);\coordinate(C)at(4,0);\coordinate(D)at(4,2.5);\coordinate(F)at(0,1.5);\coordinate(G)at(0,0);\coordinate(E)at(1.5,1.5);\fill[gray!55](F)--(A)--(C)--cycle;\draw(A)--(B)--(C)--(D)--cycle;\draw(F)--(G)--(B);\draw(F)--(A)--(C);\draw(F)--(C);\draw(F)--(E);\foreach\p/\a in {A/above,B/below,C/below right,D/above right,E/right,F/left,G/below left}\node[\a]at(\p){$\p$};
\end{tikzpicture}
