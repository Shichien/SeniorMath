\begin{tikzpicture}[thick,font=\small]
\coordinate(A)at(.5,3);\coordinate(B)at(0,0);\coordinate(C)at(3.4,0);\coordinate(D)at(2,3);\coordinate(E)at(2.65,1.65);\coordinate(F)at(1.75,1.05);\draw(A)--(B)--(C)--(D)--cycle;\draw(D)--(F)--(C);\draw(B)--(E);\foreach\p/\a in {A/above,B/below left,C/below right,D/above,E/right,F/below}\node[\a]at(\p){$\p$};
\end{tikzpicture}
