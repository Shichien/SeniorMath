\begin{tikzpicture}[line width=.9pt,blue!70!black]
\coordinate(A)at(3.5,6);
\coordinate(B)at(0,0);
\coordinate(C)at(7,0);
\coordinate(D)at(3.5,0);
\coordinate(E)at(5.316,2.886);
\coordinate(F)at(1.684,2.886);
\coordinate(G)at(3.5,1.9);
\draw(A)--(B)--(C)--cycle (A)--(D) (B)--(E) (C)--(F);
\foreach\p in {A,B,C,D,E,F,G}\fill[red](\p)circle(2.1pt);
\foreach\p/\pos in {A/above,B/left,C/right,D/below,F/left}
  \node[black,\pos]at(\p){$\p$};
\node[black,right,xshift=2pt]at(E){$E$};
\node[black,below right,xshift=2pt,yshift=-2pt]at(G){$G$};
\end{tikzpicture}
